{
  "Serilog": {
    "Using": [
      "Fydar.Dev.WebApp",
      "Serilog.Sinks.Console",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ],
    "WriteTo": {
      "console": {
        "Name": "ColoredConsole"
      }
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "S3ServiceUrl": "https://s3.us-east-1.amazonaws.com"
  },
  "AllowedHosts": "*",
  "Authentication": {
    "GitHub": {
      "ClientId": "Iv23liWFNEEyySozOfEJ",
      "AuthorizedLogins": [ "Fydar" ]
    }
  }
}
