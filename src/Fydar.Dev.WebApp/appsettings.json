{
  "Serilog": {
    "Using": [
      "Fydar.Dev.WebApp",
      "Serilog.Sinks.Console",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ],
    "WriteTo": {
      "console": {
        "Name": "ColoredConsole"
      }
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "S3ServiceUrl": "https://s3.us-east-1.amazonaws.com"
  },
  "https_port": 443,
  "AllowedHosts": "*",
  "Site": {
    "DomainName": "fydar.dev"
  }
}
