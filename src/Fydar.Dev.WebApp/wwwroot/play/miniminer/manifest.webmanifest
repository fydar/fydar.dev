{
    "name": "Mini Miner",
    "short_name": "Mini Miner",
    "version": "0.1.2.1",
    "description": "The Game Boy demake of the Nintendo DS Pokémon Diamond and Pearl underground mining minigame.",
    "categories": [
        "games"
    ],
    "id": "/play/miniminer",
    "start_url": "/play/miniminer",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "any",
    "background_color": "#12171A",
    "theme_color": "#000",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "16x16 24x24 32x32 any",
            "type": "image/svg+xml",
            "purpose": "monochrome"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "any"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "maskable"
        }
    ],
    "scope": "/play/miniminer",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        },
        {
            "src": "media/portrait.webp",
            "sizes": "720x1280",
            "form_factor": "narrow",
            "label": "Mobile gameplay"
        }
    ]
}
