{
    "name": "Astral Elites",
    "short_name": "Astral Elites",
    "version": "0.1.2.11",
    "description": "The physics-based and fast-paced asteroids clone for the modern era.",
    "categories": [
        "games"
    ],
    "id": "/play/astralelites",
    "start_url": "/play/astralelites",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "any",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "scope": "/play/astralelites",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        },
        {
            "src": "media/portrait.webp",
            "sizes": "1080x2272",
            "form_factor": "narrow",
            "label": "Mobile gameplay"
        }
    ]
}
