{
    "name": "Snoot",
    "short_name": "Snoot",
    "version": "0.0.4",
    "description": "Restore life to a desolate world by exploring a sandbox of crafting recipes. On your adventure you will bring rain, grass, bugs, birds, and bees.",
    "categories": [
        "games"
    ],
    "id": "/play/snoot",
    "start_url": "/play/snoot",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "landscape",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "16x16 24x24 32x32 any",
            "type": "image/svg+xml",
            "purpose": "monochrome"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "any"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "maskable"
        }
    ],
    "scope": "/play/snoot",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        }
    ]
}
