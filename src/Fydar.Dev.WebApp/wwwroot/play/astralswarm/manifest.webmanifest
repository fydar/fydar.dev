{
    "name": "Astral Swarm",
    "short_name": "Astral Swarm",
    "version": "0.1.0",
    "description": "Battle endless swarms of enemy space ships across the galaxy.",
    "categories": [
        "games"
    ],
    "id": "/play/astralswarm",
    "start_url": "/play/astralswarm",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "portrait",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "monochrome"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "maskable"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "any"
        }
    ],
    "scope": "/play/astralswarm",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        },
        {
            "src": "media/portrait.webp",
            "sizes": "720x1280",
            "form_factor": "narrow",
            "label": "Mobile gameplay"
        }
    ]
}
