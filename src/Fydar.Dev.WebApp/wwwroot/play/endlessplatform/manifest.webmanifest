{
    "name": "Endless Platform",
    "short_name": "Endless Platform",
    "version": "1.1.0",
    "description": "A fully procedurally generated spline-based terrain for a 2D platformer.",
    "categories": [
        "games"
    ],
    "id": "/play/endlessplatform",
    "start_url": "/play/endlessplatform",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "any",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "48x48 72x72 96x96 128x128 256x256 512x512 any",
            "type": "image/svg+xml",
            "purpose": "monochrome maskable"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "maskable"
        },
        {
            "src": "maskable.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "any"
        }
    ],
    "scope": "/play/endlessplatform",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        },
        {
            "src": "media/portrait.webp",
            "sizes": "720x1280",
            "form_factor": "narrow",
            "label": "Mobile gameplay"
        }
    ]
}
