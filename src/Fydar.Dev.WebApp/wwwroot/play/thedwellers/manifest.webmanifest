{
    "name": "The Dwellers",
    "short_name": "The Dwellers",
    "version": "0.1.0",
    "description": "A 3D dungeon crawler game demo with a full RPG item system, featuring a wide range of weapons and other equipment.",
    "categories": [
        "games"
    ],
    "id": "/play/thedwellers",
    "start_url": "/play/thedwellers",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "landscape",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.svg",
            "sizes": "48x48 72x72 96x96 128x128 256x256 512x512 any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "scope": "/play/thedwellers",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        }
    ]
}
