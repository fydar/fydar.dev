{
    "name": "Lovers' Defence",
    "short_name": "Lovers' Defence",
    "version": "1.0.0",
    "description": "A narrative driven tower defence game.",
    "categories": [
        "games"
    ],
    "id": "/play/loversdefence",
    "start_url": "/play/loversdefence",
    "display": "standalone",
    "display_override": [
        "fullscreen"
    ],
    "orientation": "landscape",
    "background_color": "#161618",
    "theme_color": "#161618",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "favicon.webp",
            "sizes": "256x256",
            "type": "image/webp",
            "purpose": "any"
        }
    ],
    "scope": "/play/loversdefence",
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "screenshots": [
        {
            "src": "media/landscape.webp",
            "sizes": "1280x720",
            "form_factor": "wide",
            "label": "Desktop gameplay"
        }
    ]
}
