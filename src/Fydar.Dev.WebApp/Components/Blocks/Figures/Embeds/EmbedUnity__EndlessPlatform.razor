@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Endless Platform",
        ProductVersion = new Version(1, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/endlessplatform/build/1.1.0.loader.js"],
        FrameworkUrl = Assets["/play/endlessplatform/build/1.1.0.framework.js.br"],
        CodeUrl = Assets["/play/endlessplatform/build/1.1.0.wasm.br"],
        DataUrl = Assets["/play/endlessplatform/build/1.1.0.data.br"],
        StreamingAssetsUrl = "/play/endlessplatform/StreamingAssets",
        Arguments = Pattern != null ? ["-pattern", Pattern] : [],
    };
}

<EmbedUnity Config="embedUnityConfig" data-embed="endlessplatform">

    <Placeholder>
        @if (!IsBackground)
        {
            <img decoding="async" class="embed--placeholdermainappicon" src="@Assets["play/endlessplatform/favicon.svg"]" alt="The logo for 'Endless Platform'." />
        }
        else
        {
            <video class="embed--placeholdervideo" autoplay muted loop playsinline disablepictureinpicture>
                <source src="@Assets["media/endlessplatform/background.h265.mp4"]" type='video/mp4; codecs="hvc1.1.6.L120.90"'>
                <source src="@Assets["media/endlessplatform/background.h264.mp4"]" type='video/mp4; codecs="avc1.640028"'>
            </video>
        }
    </Placeholder>

    <Details>
        @if (!IsBackground)
        {
            <h1>@embedUnityConfig.ProductName</h1>

            <dl>
                <dt>Version</dt>
                <dd>@embedUnityConfig.ProductVersion</dd>

                <dt>by</dt>
                <dd>@embedUnityConfig.CompanyName</dd>
            </dl>
        }
    </Details>
</EmbedUnity>

@if (IsBackground)
{
    <style>
        .embed[data-embed="endlessplatform"] div.embed--placeholder {
            background: none;
        }
    </style>
}

<style>
    .embed[data-embed="endlessplatform"] .embed--placeholdervideo {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
    }
</style>

@code {
    [Parameter] public bool IsBackground { get; set; } = false;
    [Parameter] public string? Pattern { get; set; }
}
