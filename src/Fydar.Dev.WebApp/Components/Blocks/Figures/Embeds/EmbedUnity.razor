@inject Noncer noncer

@{
    var instanceId = $"unity_{Guid.NewGuid().ToString("N")}";
    var canvasId = $"{instanceId}_canvas";
}

<ContentSecurityPolicy_Allow Directive="media-src" Sources="'self' data: blob:" />
@* The loader and framework scripts run from blob: URLs of their cached copies. *@
<ContentSecurityPolicy_Allow Directive="script-src" Sources="blob:" />

<div id="@instanceId" class="embed loading" style="--loading-percentage: 0%;" @attributes="AdditionalAttributes">
    <canvas class="embed--canvas" id="@canvasId" width=960 height=600 tabindex="-1"></canvas>
    @if (Interactive != null)
    {
        <div class="embed--interactive">
            @Interactive(instanceId)
        </div>
    }
    <div class="embed--placeholder">
        <div class="embed--placeholdermain">
            @Placeholder
            <div class="progress">
                <div class="progress--bar" style="width: var(--loading-percentage);"></div>
            </div>
        </div>
        <div class="embed--placeholderdetails">
            @if (Details != null)
            {
                @Details
            }
            else
            {
                <h1>@Config.ProductName</h1>

                <dl>
                    <dt>Version</dt>
                    <dd>@Config.ProductVersion</dd>

                    <dt>by</dt>
                    <dd>@Config.CompanyName</dd>
                </dl>
            }
        </div>
    </div>
    <div class="embed--warning"></div>

    <script nonce="@noncer.Nonce">
        if (window.trustedTypes && window.trustedTypes.createPolicy && !window.trustedTypes.defaultPolicy) {
            window.trustedTypes.createPolicy('default', {
                createScriptURL: (url) => {
                    const parsedUrl = new URL(url, window.location.origin);
                    if (parsedUrl.origin !== window.location.origin) {
                        throw new TypeError('Rejected script URL: Only same-origin scripts are allowed.');
                    }

                    return parsedUrl.href;
                }
            });
        }

        window.fydarUnityCache = window.fydarUnityCache || (function () {
            const nativeFetch = window.fetch.bind(window);
            const games = new Map();
            const inflight = new Map();
            const prefetched = new Map();

            function gameFolderOf(url) {
                for (const folder of games.keys()) {
                    if (url.pathname.startsWith(folder + "/")) {
                        return folder;
                    }
                }
                return null;
            }

            function isControlledBy(folder) {
                return !!navigator.serviceWorker?.controller
                    && (location.pathname === folder || location.pathname.startsWith(folder + "/"));
            }

            function viaCache(cacheName, key, request) {
                const previous = inflight.get(key) ?? Promise.resolve();
                const result = previous.then(async () => {
                    let cache = null;
                    try {
                        cache = await caches.open(cacheName);
                        const cached = await cache.match(key);
                        if (cached) {
                            return { response: cached, stored: null };
                        }
                    } catch (error) {
                        console.warn(`Unable to read the cache for ${key}:`, error);
                        cache = null;
                    }

                    const response = await nativeFetch(request);
                    const stored = cache && response.status === 200 && response.type === "basic"
                        ? cache.put(key, response.clone()).catch((error) => console.warn(`Unable to cache ${key}:`, error))
                        : null;
                    return { response, stored };
                });

                const settled = result.then((entry) => entry.stored, () => { });
                inflight.set(key, settled);
                settled.then(() => {
                    if (inflight.get(key) === settled) {
                        inflight.delete(key);
                    }
                });
                return result.then((entry) => entry.response);
            }

            window.fetch = function (input, init) {
                const method = init?.method ?? (input instanceof Request ? input.method : "GET");
                if (method.toUpperCase() !== "GET") {
                    return nativeFetch(input, init);
                }

                const url = new URL(input instanceof Request ? input.url : String(input), document.baseURI);
                url.hash = "";

                const early = prefetched.get(url.href);
                if (early) {
                    prefetched.delete(url.href);
                    return early;
                }

                const folder = window.caches && url.origin === location.origin ? gameFolderOf(url) : null;
                if (!folder || isControlledBy(folder)) {
                    return nativeFetch(input, init);
                }

                return viaCache(games.get(folder), url.href, new Request(input, init));
            };

            return {
                async use(folder, buildUrls) {
                    const cacheName = "fydar-" + folder.substring(folder.lastIndexOf("/") + 1);
                    games.set(folder, cacheName);
                    if (!window.caches) {
                        return;
                    }

                    try {
                        const current = new Set(buildUrls.filter(Boolean).map((url) => new URL(url, document.baseURI).href));
                        const cache = await caches.open(cacheName);
                        const keys = await cache.keys();
                        const isStale = (key) => !current.has(key.url) && new URL(key.url).pathname !== folder;
                        if (keys.some((key) => isStale(key) && new URL(key.url).pathname.startsWith(folder + "/build/"))) {
                            await Promise.all(keys.filter(isStale).map((key) => cache.delete(key)));
                        }
                    } catch (error) {
                        console.warn(`Unable to tidy the cache for ${folder}:`, error);
                    }
                },

                prefetch(url) {
                    const key = new URL(url, document.baseURI);
                    key.hash = "";
                    if (prefetched.has(key.href)) {
                        return prefetched.get(key.href).arrived;
                    }
                    const response = window.fetch(url);
                    
                    response.arrived = response.then(async (r) => {
                        const reader = r.clone().body?.getReader();
                        while (reader && !(await reader.read()).done) { }
                    }).catch(() => { });
                    prefetched.set(key.href, response);

                    response.catch(() => {
                        if (prefetched.get(key.href) === response) {
                            prefetched.delete(key.href);
                        }
                    });
                    return response.arrived;
                },

                async scriptUrl(url) {
                    const response = await window.fetch(url);
                    if (!response.ok) {
                        throw new Error(`Failed to load ${url}: ${response.status}`);
                    }
                    const blob = await response.blob();
                    return URL.createObjectURL(new Blob([blob], { type: "text/javascript" }));
                }
            };
        })();

        (async function () {
            var cache = window.fydarUnityCache;
            var buildUrls = {
                loaderUrl: "@Config.LoaderUrl",
                frameworkUrl: "@Config.FrameworkUrl",
                codeUrl: "@Config.CodeUrl",
                dataUrl: "@Config.DataUrl",
                symbolsUrl: "@Config.SymbolsUrl",
                memoryUrl: "@Config.MemoryUrl"
            };

            await cache.use("@GameFolder", Object.values(buildUrls));

            var buildArrived = Promise.all([
                cache.prefetch(buildUrls.codeUrl),
                cache.prefetch(buildUrls.dataUrl)
            ]);

            var prefetchUrls = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(Config.PrefetchUrls));
            if (prefetchUrls.length > 0) {
                buildArrived.then(() => prefetchUrls.forEach((url) => cache.prefetch(url)));
            }

            var [loaderSrc, frameworkSrc] = await Promise.all([
                cache.scriptUrl(buildUrls.loaderUrl),
                cache.scriptUrl(buildUrls.frameworkUrl)
            ]);

            var script = document.createElement("script");
            script.src = loaderSrc;
            script.setAttribute("async", "");
            script.onload = () => {
                URL.revokeObjectURL(loaderSrc);
                var config = {
                    companyName: "@Config.CompanyName",
                    productName: "@Config.ProductName",
                    productVersion: "@Config.ProductVersion",
                    frameworkUrl: frameworkSrc,
                    codeUrl: buildUrls.codeUrl,
                    dataUrl: buildUrls.dataUrl,
                    @if (!string.IsNullOrEmpty(Config.SymbolsUrl))
                    {
                        <text>symbolsUrl: buildUrls.symbolsUrl,</text>
                    }
                    @if (!string.IsNullOrEmpty(Config.MemoryUrl))
                    {
                        <text>memoryUrl: buildUrls.memoryUrl,</text>
                    }
                    streamingAssetsUrl: "@Config.StreamingAssetsUrl",
                    arguments: [@((MarkupString)(Config.Arguments.Length > 0 ? $"\"{string.Join("\", \"", Config.Arguments)}\"" : ""))]
                };

                var rootId = "@instanceId";
                var container = document.getElementById(rootId);
                var canvas = container.querySelector(".embed--canvas");
                var warningBanner = container.querySelector(".embed--warning");

                function unityShowBanner(msg, type) {
                    function updateBannerVisibility() {
                        warningBanner.style.display = warningBanner.children.length ? 'block' : 'none';
                    }
                    var div = document.createElement('div');
                    div.innerText = msg;
                    warningBanner.appendChild(div);
                    if (type == 'error') {
                        div.style = 'background: red; padding: 10px;';
                    } else {
                        if (type == 'warning') div.style = 'background: yellow; padding: 10px;';
                        setTimeout(function () {
                            warningBanner.removeChild(div);
                            updateBannerVisibility();
                        }, 5000);
                    }
                    updateBannerVisibility();
                }

                config.showBanner = unityShowBanner;

                createUnityInstance(canvas, config, (progress) => {
                    container.style.setProperty('--loading-percentage', (100 * progress) + "%");
                }).then((unityInstance) => {
                    URL.revokeObjectURL(frameworkSrc);
                    container.style.setProperty('--loading-percentage', "100%");

                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            setTimeout(() => {
                                container.classList.remove("loading");
                            }, 100);
                        });
                    });
                }).catch((message) => {
                    alert(message);
                });
            };
            document.body.appendChild(script);
        })().catch((error) => {
            console.error("Unable to start the game:", error);
        });
    </script>

    <style>
        .embed {
            position: relative;
        }

            .embed div.embed--interactive {
                position: absolute;
                width: 100%;
                height: 100%;
                overflow: hidden;
                pointer-events: none;
            }

            .embed div.embed--placeholder {
                position: absolute;
                width: 100%;
                height: 100%;
                opacity: 0;
                overflow: hidden;
                pointer-events: none;
                transition: opacity 0.25s;
                background: #161618;
            }

                .embed div.embed--placeholder div.embed--placeholdermain,
                .embed div.embed--placeholder div.embed--placeholderdetails {
                    position: absolute;
                    width: 100%;
                    height: 100%;
                }

                .embed div.embed--placeholder div.embed--placeholdermain {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    place-content: center;
                }

                    .embed div.embed--placeholder div.embed--placeholdermain .embed--placeholdermainappicon {
                        width: 200px;
                        max-width: 90%;
                        margin-bottom: 32px;
                        aspect-ratio: 1;
                    }

                .embed div.embed--placeholder div.embed--placeholderdetails {
                    place-content: end;
                    text-align: right;
                    box-sizing: border-box;
                    padding: 24px;
                    font-family: sans-serif;
                }

                    .embed div.embed--placeholder div.embed--placeholderdetails h1 {
                        font-size: 24px;
                        color: #aaaaaa;
                        margin-block-end: 0;
                        letter-spacing: 0.5px;
                        font-weight: 400;
                    }

                    .embed div.embed--placeholder div.embed--placeholderdetails dl {
                        font-size: 20px;
                        color: #7a8288;
                        margin-block-start: 6px;
                        margin-block-end: 0;
                        text-align: right;
                        line-height: 1.5;
                        letter-spacing: 0.25px;
                    }

                        .embed div.embed--placeholder div.embed--placeholderdetails dl dt {
                            display: inline;
                        }

                        .embed div.embed--placeholder div.embed--placeholderdetails dl dd {
                            display: inline;
                            margin-inline-start: unset;
                        }

                            .embed div.embed--placeholder div.embed--placeholderdetails dl dd:after {
                                content: '\A';
                                white-space: pre;
                            }

                .embed div.embed--placeholder .progress {
                    width: 300px;
                    max-width: 90%;
                    height: 18px;
                    border-radius: 6px;
                    overflow: hidden;
                    background-color: #ffffff1c;
                }

                    .embed div.embed--placeholder .progress .progress--bar {
                        width: 0%;
                        height: 100%;
                        background-image: linear-gradient(-45deg, rgba(22, 23, 24, 0.15) 25%, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 0) 50%, rgba(22, 23, 24, 0.15) 50%, rgba(22, 23, 24, 0.15) 75%, rgba(0, 0, 0, 0) 75%, rgba(0, 0, 0, 0));
                        background-size: 18px 18px;
                        background-color: #0248b0;
                        transition: width 0.25s linear;
                        animation: 1s linear infinite progress--bar-stripes;
                    }


            .embed.loading div.embed--placeholder {
                opacity: 1;
            }

            .embed canvas.embed--canvas {
                position: absolute;
                width: 100%;
                height: 100%;
                outline: 0;
            }

            .embed div.embed--warning {
            }

        @@keyframes progress--bar-stripes {
            from {
                background-position: 0 0;
            }

            to {
                background-position: 18px 0;
            }
        }
    </style>
</div>

@code {
    [Parameter, EditorRequired]
    public EmbedUnityConfig Config { get; set; }

    [Parameter]
    public RenderFragment<string>? Interactive { get; set; }

    [Parameter]
    public RenderFragment? Placeholder { get; set; }

    [Parameter]
    public RenderFragment? Details { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string GameFolder
    {
        get
        {
            var streamingAssets = Config.StreamingAssetsUrl.TrimEnd('/');
            return streamingAssets[..streamingAssets.LastIndexOf('/')];
        }
    }
}
