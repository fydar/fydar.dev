@if (CardGrid != null)
{
    <li @attributes="AdditionalAttributes" class="@CombinedClass">
        @CardInterior()
    </li>
}
else
{
    <div @attributes="AdditionalAttributes" class="@CombinedClass">
        @CardInterior()
    </div>
}

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CombinedClass
    {
        get
        {
            var baseClass = "card";
            if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("class", out var customClass))
            {
                return $"{baseClass} {customClass}";
            }
            return baseClass;
        }
    }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter(Name = "CardGrid")]
    public Block_CardGrid? CardGrid { get; set; }

    protected override void OnParametersSet()
    {
        if (CardGrid != null)
        {
            CardGrid.Register(this);
        }

        base.OnParametersSet();
    }

    private RenderFragment CardInterior()
    {
        return @<text>
                <div class="card__glow">
                    <div class="card__glow-tl"></div>
                    <div class="card__glow-t"></div>
                    <div class="card__glow-tr"></div>
                    <div class="card__glow-ml"></div>
                    <div class="card__glow-mr"></div>
                    <div class="card__glow-bl"></div>
                    <div class="card__glow-b"></div>
                    <div class="card__glow-br"></div>
                </div>
                <div class="card__border"></div>

            @ChildContent
        </text>;
    }
}
