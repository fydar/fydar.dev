@layout DefaultLayout
@page "/portfolio/lostblues"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/lostblues";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Lost Blues - Fydar");
		factory.UseDescription("The clicker-style where you farm kelp and release fish.");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/lostblues/social.webp";
			image.Alt = "Promotional material for the game 'Lost Blues'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Lost Blues", "https://fydar.dev/portfolio/lostblues"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-lostblues">

    <div class="fullscreen" data-nosnippet>
        <div class="parallax-frame parallax-focalanchortop" style="--animation-time: 0.5;">
            <picture class="parallax-layer" style="--parallax-multiplier: 0.5">
                <img decoding="async" src="@Assets["media/lostblues/background.webp"]" style="image-rendering: pixelated;" />
            </picture>
        </div>

        <div class="fullscreen-footer">
            <div class="container">
                <picture>
                    <img decoding="async" class="titlecard" src="@Assets["media/lostblues/titlecard.svg"]" alt="Title card for the game 'Lost Blues'." />
                </picture>

                <div class="titlerow">
                    <div class="flexible-space"></div>
                    <SteamPlayButton href="/play/lostblues">Play in Browser</SteamPlayButton>
                </div>
            </div>
        </div>

        <div class="cascade-container">
            <div class="cascade" style="background: linear-gradient(to right, #0c6d5700 0%, #0c6d5730 75%, #0c6d5714 100%), url('media/noise.svg');">
            </div>
        </div>
    </div>

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>Lost Blues</cite> <span class="subtle">(2019)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/lostblues/social.webp"]" alt="Promotional material for the game 'Lost Blues'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Unity />
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>The clicker-style where you farm kelp and release fish.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li class="palette-youtube"><a href="https://youtu.be/N0eWZrliNG4" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-youtube" Alt="YouTube" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
                <EmbedYouTube Url="https://www.youtube-nocookie.com/embed/N0eWZrliNG4?si=h22aoTU4bFP9cmiF" />
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <OutlineSection Id="procedural-kelp" LinkName="Procedural Kelp Swaying">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing the</p>
                            <h2>Procedural Kelp Swaying</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>

<PwaInstall AppId="lostblues"
            Scope="/play/lostblues"
            ServiceWorkerUrl="@Assets["play/lostblues.serviceworker.js"]"
            ManifestUrl="@Assets["/play/lostblues/manifest.webmanifest"]" />
