@layout DefaultLayout
@page "/portfolio/loversdefence"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/loversdefence";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Lovers' Defence - Fydar");
		factory.UseDescription("A narrative driven tower defence game.");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/loversdefence/social.webp";
			image.Alt = "Promotional material for the game 'Lovers' Defence'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Lovers' Defence", "https://fydar.dev/portfolio/loversdefence"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-loversdefence">

    <div class="fullscreen" data-nosnippet>
        <div class="parallax-frame parallax-focalanchortop" style="--animation-time: 0.5;">
            <picture class="parallax-layer" style="--parallax-multiplier: 0.5">
                <img decoding="async" src="@Assets["media/loversdefence/background.webp"]" style="image-rendering: pixelated;" />
            </picture>
        </div>

        <div class="fullscreen-footer">
            <div class="container">
                <picture>
                    <img decoding="async" class="titlecard" src="@Assets["media/loversdefence/titlecard.png"]" alt="Title card for the game 'Lovers' Defence'." style="image-rendering: pixelated;" />
                </picture>

                <div class="titlerow">
                    <div class="flexible-space"></div>
                    <SteamPlayButton href="/play/loversdefence">Play in Browser</SteamPlayButton>
                </div>
            </div>
        </div>

        <div class="cascade-container">
            <div class="cascade" style="background: linear-gradient(to right, #75a84700 0%, #75a84730 75%, #75a84714 100%), url('media/noise.svg');">
            </div>
        </div>
    </div>

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>Lovers' Defence</cite> <span class="subtle">(2022)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/loversdefence/social.webp"]" alt="Promotional material for the game 'Lovers' Defence'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Unity />
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>A narrative driven tower defence game.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li class="palette-ludumdare-jam"><a href="https://ldjam.com/events/ludum-dare/50/lovers-defence" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-ludumdareinactive" Alt="Ludum Dare" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <Card_GameJam Palette="palette-ludumdare-jam"
                    Href="https://ldjam.com/events/ludum-dare/50/lovers-defence"
                    Name="Ludum Dare 50 Jam"
                    IconLink="/icons.svg?v=1#icon-ludumdare"
                    IconAlt="Ludum Dare"
                    Duration="72 Hours"
                    Theme="Delay the Inevitable" />

                <OutlineSection Id="dialogue-system" LinkName="Dialogue System">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing the</p>
                            <h2>Dialogue System</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>

<PwaInstall AppId="loversdefence"
            Scope="/play/loversdefence"
            ServiceWorkerUrl="@Assets["play/loversdefence.serviceworker.js"]"
            ManifestUrl="@Assets["/play/loversdefence/manifest.webmanifest"]" />
