@layout DefaultLayout
@page "/portfolio/roadtonorthstead"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/roadtonorthstead";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Road to Northstead - Fydar");
		factory.UseDescription("The game jam visual novel with questing and crafting to survive the night.");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/roadtonorthstead/social.webp";
			image.Alt = "Promotional material for the game 'Road to Northstead'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Road to Northstead", "https://fydar.dev/portfolio/roadtonorthstead"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-roadtonorthstead">

    <div class="fullscreen" data-nosnippet>
        <div class="parallax-frame">
            <picture class="parallax-layer" style="--parallax-multiplier: 0.5">
                <img decoding="async" src="@Assets["media/roadtonorthstead/background.webp"]" style="image-rendering: pixelated;" data-thumbhash="zfgFFIIJ10hlh4eCe4kIZcIgRA==" />
            </picture>
        </div>

        <div class="fullscreen-footer">
            <div class="container">
                <picture>
                    <img decoding="async" class="titlecard" src="@Assets["media/roadtonorthstead/titlecard.svg"]" alt="Title card for the game 'Road to Northstead'." />
                </picture>

                <div class="titlerow">
                    <div class="flexible-space"></div>
                    <SteamPlayButton href="/play/roadtonorthstead">Play in Browser</SteamPlayButton>
                </div>
            </div>
        </div>

        <div class="cascade-container">
            <div class="cascade" style="background: linear-gradient(to right, #64692800 0%, #64692830 75%, #64692814 100%), url('media/noise.svg');">
            </div>
        </div>
    </div>

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>Road to Northstead</cite> <span class="subtle">(2019)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/roadtonorthstead/social.webp"]" alt="Promotional material for the game 'Road to Northstead'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Unity />
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>The game jam visual novel with questing and crafting to survive the night.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li class="palette-youtube"><a href="https://youtu.be/nt5aEzyqaOU" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-youtube" Alt="YouTube" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
                <EmbedYouTube Url="https://www.youtube-nocookie.com/embed/nt5aEzyqaOU?si=UYA_5Xe3CJ7Qcsj6" />
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <OutlineSection Id="questing-system" LinkName="Data-Driven Questing System">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing a</p>
                            <h2>Data-Driven Questing System</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

                <OutlineSection Id="dialogue-system" LinkName="Dialogue System">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing a</p>
                            <h2>Dialogue System</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>

<PwaInstall AppId="roadtonorthstead"
            Scope="/play/roadtonorthstead"
            ServiceWorkerUrl="@Assets["play/roadtonorthstead.serviceworker.js"]"
            ManifestUrl="@Assets["/play/roadtonorthstead/manifest.webmanifest"]" />
