@layout DefaultLayout
@page "/portfolio/pewpew"

@{
    var canonicalUrl = "https://fydar.dev/portfolio/pewpew";
    void PageMetadata(IMetadataFactory factory)
    {
        factory.UseTitle("Pew Pew - Fydar");
        factory.UseDescription("A 20v20 .io style browser game made in 48 hours using ASP.NET Core and hosted in AWS.");
        factory.UseCanonicalUrl(canonicalUrl);
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/pewpew/social.webp";
            image.Alt = "Promotional material for the game 'Pew Pew'.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
        new BreadcrumbListItem("Pew Pew", "https://fydar.dev/portfolio/pewpew"),
    };
}

<HeadFragment>
    <MetadataComponent Metadata="@PageMetadata" />
    <BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-pewpew">

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>Pew Pew</cite> <span class="subtle">(2021)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/pewpew/social.webp"]" alt="Promotional material for the game 'Pew Pew'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Backend />
                    <Pill_CSharp />
                    <Pill_Multiplayer />
                </Block_PillCloud>

                <p>A 20v20 .io style browser game made in 48 hours using ASP.NET Core and hosted in AWS.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li><a href="https://github.com/fydar/PewPew" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-github" Alt="GitHub" /></a></li>
                    <li class="palette-youtube"><a href="https://youtu.be/9DOz6ob91zM" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-youtube" Alt="YouTube" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
                <EmbedYouTube Url="https://www.youtube-nocookie.com/embed/9DOz6ob91zM?si=9wSx2SPaN7-wz7OO" />
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <Card_GameJam Palette="palette-globalgamejam"
                    Href="https://github.com/fydar/PewPew"
                    Name="Global Game Jam 2021"
                    IconLink="/icons.svg?v=1#icon-globalgamejam"
                    IconAlt="Global Game Jam"
                    Duration="48 Hours"
                    Theme="Lost and Found"
                    TeamSize="Solo" />

                <OutlineSection Id="websockets" LinkName="WebSocket Multiplayer">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing</p>
                            <h2>WebSocket Multiplayer</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <p>Inspired by browser-based .io games like <i>Agar.io</i>, I wanted to build a multiplayer browser game entirely from scratch within the 48-hour jam. I used <b>Blazor WebAssembly</b> as the game client and connected it to an <b>ASP.NET Core</b> backend via <b>WebSockets</b> for real-time player communication.</p>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>
