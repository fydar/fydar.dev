@layout DefaultLayout
@page "/portfolio/snoot"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/snoot";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Snoot - Fydar");
		factory.UseDescription("Restore life to a desolate world by exploring a sandbox of crafting recipes. On your adventure you will bring rain, grass, bugs, birds, and bees.");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/snoot/social.webp";
			image.Alt = "Promotional material for the game 'Snoot'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Snoot", "https://fydar.dev/portfolio/snoot"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-snoot">

    <div class="fullscreen" data-nosnippet>
        <div class="parallax-frame parallax-focalanchortop" style="--animation-time: 0.5;">
            <picture class="parallax-layer" style="--parallax-multiplier: 0.5">
                <img decoding="async" src="@Assets["media/snoot/background.webp"]" />
            </picture>
        </div>

        <div class="fullscreen-footer">
            <div class="container">
                <picture>
                    <img decoding="async" class="titlecard" src="@Assets["media/snoot/titlecard.svg"]" alt="Title card for the game 'Snoot'." />
                </picture>

                <div class="titlerow">
                    <div class="flexible-space"></div>
                    <SteamPlayButton href="/play/snoot">Play in Browser</SteamPlayButton>
                </div>
            </div>
        </div>

        <div class="cascade-container">
            <div class="cascade" style="background: linear-gradient(to right, #88a06c00 0%, #88a06c30 75%, #88a06c14 100%), url('media/noise.svg');">
            </div>
        </div>
    </div>

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>Snoot</cite> <span class="subtle">(2020)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/snoot/social.webp"]" alt="Promotional material for the game 'Snoot'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Unity />
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>Restore life to a desolate world by exploring a sandbox of crafting recipes. On your adventure you will bring rain, grass, bugs, birds, and bees.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li><a href="https://github.com/fydar/Snoot" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-github" Alt="GitHub" /></a></li>
                    <li class="palette-youtube"><a href="https://youtu.be/QG4aYGcsoio" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-youtube" Alt="YouTube" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
                <EmbedYouTube Url="https://www.youtube-nocookie.com/embed/QG4aYGcsoio?si=vaE8GRl9teAlJEjI" />
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <Card_GameJam Palette="palette-globalgamejam"
                    Href="https://github.com/fydar/Snoot"
                    Name="Global Game Jam 2020"
                    IconLink="/icons.svg?v=1#icon-globalgamejam"
                    IconAlt="Global Game Jam"
                    Duration="48 Hours"
                    Theme="Repair"
                    TeamSize="3-Person" />

                <OutlineSection Id="crafting" LinkName="Inventory and Crafting">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing</p>
                            <h2>Inventory and Crafting</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <p>Inspired by games like <i>Little Alchemy</i>, where combining elements unlocks new discoveries, and <i>Animal Crossing: New Horizons</i>, the team wanted players to craft the very life that would populate a desolate world. I built the inventory, crafting, and world interaction systems in <b>Unity</b>, enabling players to combine items and watch the world react as rain, grass, insects, birds, and bees gradually appear.</p>

                </OutlineSection>

                <OutlineSection Id="shader" LinkName="World Warp Shader">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing the</p>
                            <h2>World Warp Shader</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <p>To give the tiny world a sense of scale and roundness, I created a shader that bends the terrain geometry over the horizon like a miniature planet.</p>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>

<PwaInstall AppId="snoot"
            Scope="/play/snoot"
            ServiceWorkerUrl="@Assets["play/snoot.serviceworker.js"]"
            ManifestUrl="@Assets["/play/snoot/manifest.webmanifest"]" />
