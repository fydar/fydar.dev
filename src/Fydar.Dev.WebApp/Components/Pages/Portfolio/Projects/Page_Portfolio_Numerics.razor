@layout DefaultLayout
@page "/portfolio/numerics"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/numerics";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Numerics - Fydar");
		factory.UseDescription("A complete numerics system.");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/header.webp";
			image.Alt = "A portrait of Fydar in an anime art style.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Numerics", "https://fydar.dev/portfolio/numerics"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadContent>

<article class="page-numerics">

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet>Numerics</h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <Block_PillCloud>
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>A complete numerics system.</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li><a href="https://github.com/fydar/Deterministic" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-github" Alt="GitHub" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <OutlineSection Id="fixed-points" LinkName="Fixed-Point Mathematics">
                    <Block_ArticleHeading>
                        <h2>Fixed-Point Mathematics</h2>
                    </Block_ArticleHeading>

                    <p>A common problem when programming a <b>deterministic simulation</b> is <b>deterministic mathematics</b>. One way to achieve <b>deterministic mathematics</b> is to use a <b>fixed-point numeric</b> as an alternative to the built-in <b>floating point numeric</b>. This is a commonly employed strategy by RTS games.</p>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>
