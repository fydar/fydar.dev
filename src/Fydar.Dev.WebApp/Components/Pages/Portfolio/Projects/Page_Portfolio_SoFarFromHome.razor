@layout DefaultLayout
@page "/portfolio/sofarfromhome"

@{
	var canonicalUrl = "https://fydar.dev/portfolio/sofarfromhome";
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("So Far From Home - Fydar");
		factory.UseDescription("Searching between the sofa cushions for a missing key, but what else is down there?");
		factory.UseCanonicalUrl(canonicalUrl);
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/sofarfromhome/social.webp";
			image.Alt = "Promotional material for the game 'So Far From Home'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("So Far From Home", "https://fydar.dev/portfolio/sofarfromhome"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadContent>

<article class="page-sofarfromhome">

    <div class="fullscreen" data-nosnippet>
        <div class="parallax-frame parallax-focalanchortop" style="--animation-time: 0.5;">
            <picture class="parallax-layer" style="--parallax-multiplier: 0.5">
                <img decoding="async" src="@Assets["media/sofarfromhome/background.webp"]" />
            </picture>
        </div>

        <div class="fullscreen-footer">
            <div class="container">
                <picture>
                    <img decoding="async" class="titlecard" src="@Assets["media/sofarfromhome/titlecard.svg"]" alt="Title card for the game 'So Far From Home'." />
                </picture>

                <div class="titlerow">
                    <div class="flexible-space"></div>
                    <SteamPlayButton href="/play/sofarfromhome">Play in Browser</SteamPlayButton>
                </div>
            </div>
        </div>

        <div class="cascade-container">
            <div class="cascade" style="background: linear-gradient(to right, #66352a00 0%, #66352a30 75%, #66352a14 100%), url('media/noise.svg');">
            </div>
        </div>
    </div>

    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet><cite>So Far From Home</cite> <span class="subtle">(2019)</span></h1>
        </Block_ArticleHeader>

        <Block_ArticleIntroduction>
            <Sidebar>
                <img decoding="async" class="article-featuredimage" src="@Assets["media/sofarfromhome/social.webp"]" alt="Promotional material for the game 'So Far From Home'." />

                <Block_PillCloud>
                    <Pill_GameJam />
                    <Pill_Unity />
                    <Pill_CSharp />
                </Block_PillCloud>

                <p>Searching between the sofa cushions for a missing key, but what else is down there?</p>

                <menu class="externallinks" aria-label="Project External links">
                    <li><a href="https://github.com/fydar/SoFarFromHome" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-github" Alt="GitHub" /></a></li>
                    <li class="palette-youtube"><a href="https://youtu.be/I7_W-q0Np6s" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-youtube" Alt="YouTube" /></a></li>
                </menu>

                <ShareLink Url="@canonicalUrl" />
            </Sidebar>
            <Container>
                <EmbedYouTube Url="https://www.youtube-nocookie.com/embed/I7_W-q0Np6s?si=W4b_-U3gF05PN4SB" />
            </Container>
        </Block_ArticleIntroduction>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>

                <Card_GameJam Palette="palette-globalgamejam"
                    Href="https://github.com/fydar/SoFarFromHome"
                    Name="Global Game Jam 2019"
                    IconLink="/icons.svg?v=1#icon-globalgamejam"
                    IconAlt="Global Game Jam"
                    Duration="48 Hours"
                    Theme="Home"
                    TeamSize="6-Person" />

                <OutlineSection Id="tutorial" LinkName="Tutorial System">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing the</p>
                            <h2>Tutorial System</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <p>After a chaotic and memorable ideas session, the team settled on a game set between the cushions of a sofa, a tactile, intimate hunt for lost objects. To ease players into the unusual perspective and mechanics, I built a tutorial system that introduces each interaction step by step without interrupting the atmosphere.</p>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

                <OutlineSection Id="dialogue" LinkName="Dialogue System">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Implementing the</p>
                            <h2>Dialogue System</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <p>To guide players through the narrative without breaking the sense of quiet discovery, I created a dialogue system that delivers story beats and contextual hints as the player interacts with objects hidden between the cushions.</p>

                    <Block_Callout Type="construction">
                        <Icon><SvgSprite Link="/icons.svg?v=1#fluent-emoji-high-contrast--construction" Alt="Check" /></Icon>
                        <ChildContent>This section of my website is currently <b>under construction</b>.</ChildContent>
                    </Block_Callout>
                </OutlineSection>

                <OutlineSection Id="team" LinkName="Team">
                    <Block_ArticleHeading>
                        <hgroup>
                            <p>Meet the</p>
                            <h2>Team</h2>
                        </hgroup>
                    </Block_ArticleHeading>

                    <figure class="figure-image" style="width: 100%; background: #2727273b;">
                        <picture>
                            <img decoding="async" src="@Assets["media/sofarfromhome/sofarfromhome-meettheteam.webp"]" alt="The score for 'Sonar' composed for Raid Healer Simulator." loading="lazy" />
                        </picture>
                        <figcaption>The team behind 'So Far From Home', from left to right: Aoife, Denis, Fydar, Paul, and Evan.</figcaption>
                    </figure>

                </OutlineSection>

            </Content>
        </Block_ArticleOutlined>
    </div>
</article>

<PwaInstall AppId="sofarfromhome"
            Scope="/play/sofarfromhome"
            ServiceWorkerUrl="@Assets["play/sofarfromhome.serviceworker.js"]"
            ManifestUrl="@Assets["/play/sofarfromhome/manifest.webmanifest"]" />
