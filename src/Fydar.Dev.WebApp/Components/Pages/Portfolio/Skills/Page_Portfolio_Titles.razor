@layout DefaultLayout
@page "/portfolio/titles"

@{
    void PageMetadata(IMetadataFactory factory)
    {
        factory.UseTitle("Titles - Fydar");
        factory.UseDescription("Commercial game titles I have worked on professionally.");
        factory.UseCanonicalUrl("https://fydar.dev/portfolio/titles");
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/placeholdersocial.webp";
            image.Alt = "Fydar's signature.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
        new BreadcrumbListItem("Titles", "https://fydar.dev/portfolio/titles"),
    };
}

<HeadFragment>
    <MetadataComponent Metadata="@PageMetadata" />
    <BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-titles">
    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet>Titles</h1>
        </Block_ArticleHeader>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>
                <OutlineSection Id="2026" LinkName="2026">
                    <Block_ArticleHeading>
                        <h2>2026 <span class="subtle">(1)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_TwilightTowers />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2025" LinkName="2025">
                    <Block_ArticleHeading>
                        <h2>2025 <span class="subtle">(1)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_HavocCrew />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2024" LinkName="2024">
                    <Block_ArticleHeading>
                        <h2>2024 <span class="subtle">(2)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_UNO />
                        <Cover_Phasmophobia />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2022" LinkName="2022">
                    <Block_ArticleHeading>
                        <h2>2022 <span class="subtle">(2)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_Outrage />
                        <Cover_Southfield />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2020" LinkName="2020">
                    <Block_ArticleHeading>
                        <h2>2020 <span class="subtle">(2)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_StarCitizen />
                        <Cover_Squadron42 />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2018" LinkName="2018">
                    <Block_ArticleHeading>
                        <h2>2018 <span class="subtle">(1)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_LegoStarWarsBattles />
                    </Block_CoverGrid>
                </OutlineSection>

                <OutlineSection Id="2017" LinkName="2017">
                    <Block_ArticleHeading>
                        <h2>2017 <span class="subtle">(1)</span></h2>
                    </Block_ArticleHeading>
                    <Block_CoverGrid>
                        <Cover_Eitr />
                    </Block_CoverGrid>
                </OutlineSection>
            </Content>
        </Block_ArticleOutlined>
    </div>
</article>
