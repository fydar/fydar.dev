@layout DefaultLayout
@page "/portfolio/technicalart"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Technical Art - Fydar");
		factory.UseDescription("A collection of technical art pieces I've developed.");
		factory.UseCanonicalUrl("https://fydar.dev/portfolio/technicalart");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/header.webp";
			image.Alt = "A portrait of Fydar in an anime art style.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Portfolio", "https://fydar.dev/portfolio"),
		new BreadcrumbListItem("Technical Art", "https://fydar.dev/portfolio/technicalart"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<article class="page-technicalart">
    <div class="container">
        <Block_ArticleHeader>
            <h1 data-nosnippet>Technical Art</h1>
        </Block_ArticleHeader>

        <Block_ArticleOutlined>
            <Sidebar>
                <aside>
                    <Block_TableOfContents />
                </aside>
            </Sidebar>
            <Content>
                <OutlineSection Id="professional" LinkName="Professional">
                    <Block_ArticleHeading>
                        <h2>Professional</h2>
                    </Block_ArticleHeading>

                    <Block_CoverGrid>

                        <CoverDate Date="2025">
                            <Cover_Phasmophobia />
                        </CoverDate>

                        <CoverDate Date="2024">
                            <Cover_UNO />
                        </CoverDate>

                        <CoverDate>
                            <Cover_Southfield />
                        </CoverDate>

                    </Block_CoverGrid>

                    <div style="height: 24px"></div>

                    <Block_CardGrid>
                        <Card>
                            <a class="card__link" href="https://www.gamesindustry.biz/technical-art-roles-what-they-are-and-how-to-get-one" target="_blank">EGX 2023 Panellist</a>
                            <picture>
                                <img class="card__image" decoding="async" loading="lazy" width="640" height="480" src="@Assets["media/companies/radicalforge/egx-card.webp"]" alt="Preview of the EGX talk." />
                            </picture>
                            <div class="container">
                                <header>
                                    <SvgSprite class="card-keyicon" Link="/icons.svg?v=1#tabler--brush" />
                                    <h3>EGX 2023 Panellist</h3>
                                </header>
                                <p>Technical art roles: What they are, and how to get one</p>
                            </div>
                        </Card>
                    </Block_CardGrid>
                </OutlineSection>
            </Content>
        </Block_ArticleOutlined>
    </div>
</article>
