@using Fydar.Dev.Services.EmailTickets;
@using Fydar.Dev.Services.EmailTickets.Models;
@using Fydar.Dev.WebApp.Internal.Authentication;
@using Microsoft.AspNetCore.Authorization;

@layout DefaultLayout
@page "/ticket"

@attribute [Authorize(Policy = GitHubAuthenticationDefaults.AuthorizationPolicy)]

@inject IEmailReaderService emailReaderService;
@inject ILogger<Page_Ticket_List> logger;

<PageTitle>Tickets - Fydar</PageTitle>

<article class="page-ticket-list">
    <div class="container" style="max-width: 900px;">

        <AuthorizeView>
            <div class="ticket-identity">
                <span>Signed in as @context.User.Identity?.Name</span>
                <form method="post" action="@GitHubAuthenticationDefaults.SignOutPath">
                    <AntiforgeryToken />
                    <button class="ticket-identity-signout" type="submit">Sign out</button>
                </form>
            </div>
        </AuthorizeView>

        <h2>Tickets</h2>

        @if (deletedTicketIds.Length > 0)
        {
            <p class="ticket-list-notice">
                <span>@(deletedTicketIds.Length == 1 ? "1 ticket deleted." : $"{deletedTicketIds.Length} tickets deleted.")</span>
                <EditForm Model="this" FormName="undo-tickets" OnSubmit="HandleUndo" Enhance>
                    @foreach (var ticketId in deletedTicketIds)
                    {
                        <input type="hidden" name="undoTicketIds" value="@ticketId" />
                    }
                    <button class="ticket-list-notice-undo" type="submit">Undo</button>
                </EditForm>
            </p>
        }

        @if (tickets == null)
        {
            <p><em>Loading...</em></p>
        }
        else if (tickets.TotalCount == 0)
        {
            <p><em>There are no tickets.</em></p>
        }
        else
        {
            <EditForm Model="this" FormName="ticket-list" OnSubmit="HandleBulkDelete" Enhance>
                <div class="ticket-list-toolbar">
                    <button type="submit" class="ticket-list-toolbar-button" title="Delete the checked tickets">Delete</button>
                </div>

                <ol class="ticket-list">
                    @foreach (var entry in entries)
                    {
                        <li class="ticket-list-item">
                            <input type="checkbox" class="ticket-list-checkbox" name="selectedTicketIds" value="@entry.TicketId" aria-label="Select this ticket" />
                            <a class="ticket-list-link" href="/ticket/@Uri.EscapeDataString(entry.TicketId)">
                                <span class="ticket-list-subject">@entry.Subject</span>
                                <span class="ticket-list-from">@entry.From</span>
                                <time class="ticket-list-received" datetime="@entry.Received.ToString("o")">
                                    @entry.Received.ToString("yyyy-MM-dd HH:mm") UTC
                                </time>
                            </a>
                        </li>
                    }
                </ol>
            </EditForm>

            <nav class="ticket-pagination" aria-label="Ticket pages">
                @if (tickets.PageNumber > 1)
                {
                    <a class="ticket-pagination-link" rel="prev" href="@HrefForPage(tickets.PageNumber - 1)">Newer</a>
                }
                else
                {
                    <span class="ticket-pagination-link ticket-pagination-disabled">Newer</span>
                }

                <span class="ticket-pagination-position">
                    Page @tickets.PageNumber of @tickets.TotalPages
                </span>

                @if (tickets.PageNumber < tickets.TotalPages)
                {
                    <a class="ticket-pagination-link" rel="next" href="@HrefForPage(tickets.PageNumber + 1)">Older</a>
                }
                else
                {
                    <span class="ticket-pagination-link ticket-pagination-disabled">Older</span>
                }
            </nav>
        }
    </div>
</article>

@code {
    private const int PageSize = 20;

    /// <summary>
    /// <para>Bound as text so that a hand-edited '?page=' lands on the first page instead of
    /// failing the request.</para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? Page { get; set; }

    // Read directly from the request rather than via [SupplyParameterFromForm], since the number
    // of checked boxes is unknown ahead of time and this reads however many the browser posted.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private TicketPageModel? tickets;
    private TicketListEntry[] entries = [];
    private int pageNumber;

    private string[] deletedTicketIds = [];

    protected override async Task OnInitializedAsync()
    {
        pageNumber = int.TryParse(Page, out int requestedPage)
            ? requestedPage
            : 1;

        await LoadAsync();
    }

    private async Task HandleBulkDelete()
    {
        string[] ticketIds = FormValues("selectedTicketIds");
        if (ticketIds.Length == 0)
        {
            return;
        }

        IReadOnlyList<string> deleted;
        try
        {
            deleted = await emailReaderService.DeleteEmailsAsync(ticketIds);
        }
        catch (Exception exception)
        {
            logger.LogWarning(exception, "Failed to delete {Count} ticket(s).", ticketIds.Length);
            deleted = [];
        }

        LogSkipped(ticketIds, deleted, "delete");

        deletedTicketIds = [.. deleted];

        await LoadAsync();
    }

    private async Task HandleUndo()
    {
        string[] ticketIds = FormValues("undoTicketIds");
        if (ticketIds.Length == 0)
        {
            return;
        }

        IReadOnlyList<string> restored;
        try
        {
            restored = await emailReaderService.RestoreEmailsAsync(ticketIds);
        }
        catch (Exception exception)
        {
            logger.LogWarning(exception, "Failed to restore {Count} ticket(s).", ticketIds.Length);
            restored = [];
        }

        LogSkipped(ticketIds, restored, "restore");

        deletedTicketIds = [];

        await LoadAsync();
    }

    // The batch APIs report which ids actually moved rather than throwing per item, so a request
    // that came back short is logged here instead of in a per-item catch block.
    private void LogSkipped(IReadOnlyCollection<string> requested, IReadOnlyCollection<string> succeeded, string action)
    {
        foreach (string ticketId in requested)
        {
            if (!succeeded.Contains(ticketId))
            {
                logger.LogWarning("Failed to {Action} the ticket {TicketId}.", action, ticketId);
            }
        }
    }

    private string[] FormValues(string name)
    {
        if (HttpContext is null)
        {
            return [];
        }

        return [.. HttpContext.Request.Form[name]
            .Where(value => !string.IsNullOrEmpty(value))
            .Distinct()!];
    }

    private async Task LoadAsync()
    {
        tickets = await emailReaderService.ListEmailsAsync(pageNumber, PageSize);

        // The listing carries only keys, so the sender and subject of each ticket on this page
        // come from the emails themselves.
        entries = await Task.WhenAll(tickets.Tickets.Select(ReadEntryAsync));
    }

    private async Task<TicketListEntry> ReadEntryAsync(TicketSummaryModel ticket)
    {
        try
        {
            var message = await emailReaderService.ReadEmailAsync(ticket.TicketId);

            return new TicketListEntry(
                ticket.TicketId,
                ticket.LastModified,
                string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject,
                message.From.ToString());
        }
        catch (Exception exception)
        {
            // A single unreadable ticket shouldn't take the whole listing down with it.
            logger.LogWarning(exception, "Failed to read the ticket {TicketId} whilst listing tickets.", ticket.TicketId);

            return new TicketListEntry(
                ticket.TicketId,
                ticket.LastModified,
                "(couldn't be read)",
                string.Empty);
        }
    }

    private static string HrefForPage(int pageNumber)
    {
        return pageNumber <= 1
            ? "/ticket"
            : $"/ticket?page={pageNumber}";
    }

    private sealed record TicketListEntry(
        string TicketId,
        DateTime Received,
        string Subject,
        string From);
}
