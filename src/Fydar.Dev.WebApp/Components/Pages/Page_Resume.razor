    {
        factory.UseTitle("Resume - Fydar");
        factory.UseDescription("Here you can find my resume, documenting my 9-year career in the Games Development industry.");
        factory.UseCanonicalUrl("https://fydar.dev/resume");
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/placeholdersocial.webp";
            image.Alt = "Fydar's signature.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Resume", "https://fydar.dev/resume/"),
    };
}

