                    <br />
                    <a class="link-tag" href="@explicitBaseUri/portfolio/havoccrew" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-game-controller-duotone" Alt="Game" />Havoc Crew<SvgSprite Link="/icons.svg?v=1#icon-external-link" class="external-link-icon" /></a>
                    <a class="link-tag" href="@explicitBaseUri/portfolio/twilighttowers" target="_blank"><SvgSprite Link="/icons.svg?v=1#icon-game-controller-duotone" Alt="Game" />Twilight Towers<SvgSprite Link="/icons.svg?v=1#icon-external-link" class="external-link-icon" /></a>
