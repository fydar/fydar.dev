@using Amazon.S3;
@using Fydar.Dev.Services.EmailTickets;
@using Fydar.Dev.WebApp.Internal;
@using Fydar.Dev.WebApp.Internal.Authentication;
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.WebUtilities;
@using MimeKit
@using System.Net

@layout DefaultLayout
@page "/ticket/{ticketId}"

@attribute [Authorize(Policy = GitHubAuthenticationDefaults.AuthorizationPolicy)]

<!-- Disabled whilst framework.js is also disabled @@attribute [StreamRendering(true)] -->

@inject IEmailReaderService emailReaderService;
@inject TicketHtmlSanitizer ticketHtmlSanitizer;
@inject NavigationManager NavigationManager

<PageTitle>Ticket - Fydar</PageTitle>

@if (TrustRemoteContent)
{
    @* The site's policy only allows images from itself, which would block a trusted email's
       images just as firmly as the sanitizer does. *@
    <ContentSecurityPolicy_Allow Directive="img-src" Sources="https:" />
}

<article class="page-ticket">
    <div class="container" style="max-width: 900px;">

        <AuthorizeView>
            <div class="ticket-identity">
                <span>Signed in as @context.User.Identity?.Name</span>
                <form method="post" action="@GitHubAuthenticationDefaults.SignOutPath">
                    <AntiforgeryToken />
                    <button class="ticket-identity-signout" type="submit">Sign out</button>
                </form>
            </div>
        </AuthorizeView>

        @if (mimeMessage == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            var body = ticketHtmlSanitizer.Sanitize(mimeMessage, TrustRemoteContent);

            <p class="ticket-from">@mimeMessage.From.ToString()</p>

            <p class="ticket-to">@mimeMessage.To.ToString()</p>

            @if (body.BlockedRemoteContent)
            {
                <p class="ticket-blocked">
                    <span>
                        Images and other content this email loads from elsewhere are blocked.
                        Fetching them tells the sender their message was opened.
                    </span>
                    <a class="ticket-blocked-trust" href="@TrustUrl">Load remote content</a>
                </p>
            }

            <div class="ticket-body">
                @if (mimeMessage.HtmlBody is not null)
                {
                    @body.Html
                }
                else
                {
                    <div class="ticket-body-text">@mimeMessage.TextBody</div>
                }
            </div>

            @if (attachments.Count > 0)
            {
                <section class="ticket-attachments" aria-labelledby="ticket-attachments-heading">
                    <h3 id="ticket-attachments-heading" class="ticket-attachments-heading">
                        @(attachments.Count == 1 ? "1 attachment" : $"{attachments.Count} attachments")
                    </h3>
                    <ul class="ticket-attachment-list">
                        @foreach (var attachment in attachments)
                        {
                            <li>
                                @* A download is a file to save, not a page for enhanced navigation to fetch. *@
                                <a class="ticket-attachment"
                                   href="@TicketAttachments.DownloadUrl(TicketId, attachment.Index)"
                                   download="@attachment.FileName"
                                   data-enhance-nav="false">
                                    <SvgSprite class="ticket-attachment-icon" Link="/icons.svg?v=1#icon-download" />
                                    <span class="ticket-attachment-name">@attachment.FileName</span>
                                    <span class="ticket-attachment-meta">@attachment.MediaType · @FormatSize(attachment.Size)</span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </div>
</article>

@code {
    [Parameter]
    public string TicketId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "trust")]
    public bool TrustRemoteContent { get; set; }

    private string TrustUrl =>
        QueryHelpers.AddQueryString($"/ticket/{Uri.EscapeDataString(TicketId)}", "trust", "true");

    private MimeMessage? mimeMessage;
    private IReadOnlyList<TicketAttachment> attachments = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mimeMessage = await emailReaderService.ReadEmailAsync(TicketId);
            attachments = TicketAttachments.Collect(mimeMessage);
        }
        catch (AmazonS3Exception exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            NavigationManager.NotFound();
        }
    }

    private static string FormatSize(long bytes)
    {
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
            _ => $"{bytes / (1024.0 * 1024.0):0.#} MB"
        };
    }
}
