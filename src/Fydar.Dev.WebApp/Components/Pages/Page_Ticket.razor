@using Fydar.Dev.Services.EmailTickets;
@using Fydar.Dev.WebApp.Internal;
@using Fydar.Dev.WebApp.Internal.Authentication;
@using Microsoft.AspNetCore.Authorization;
@using MimeKit

@layout DefaultLayout
@page "/ticket/{ticketId}"

@attribute [Authorize(Policy = GitHubAuthenticationDefaults.AuthorizationPolicy)]

<!-- Disabled whilst framework.js is also disabled @@attribute [StreamRendering(true)] -->

@inject IEmailReaderService emailReaderService;
@inject TicketHtmlSanitizer ticketHtmlSanitizer;

<PageTitle>Ticket - Fydar</PageTitle>

@if (TrustRemoteContent)
{
    @* The site's policy only allows images from itself, which would block a trusted email's
       images just as firmly as the sanitizer does. *@
    <ContentSecurityPolicy_Allow Directive="img-src" Sources="https:" />
}

<article class="page-ticket">
    <div class="container" style="max-width: 900px;">

        <AuthorizeView>
            <div class="ticket-identity">
                <span>Signed in as @context.User.Identity?.Name</span>
                <form method="post" action="@GitHubAuthenticationDefaults.SignOutPath">
                    <AntiforgeryToken />
                    <button class="ticket-identity-signout" type="submit">Sign out</button>
                </form>
            </div>
        </AuthorizeView>

        @if (mimeMessage == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            var body = ticketHtmlSanitizer.Sanitize(mimeMessage.HtmlBody, TrustRemoteContent);

            <p class="ticket-from">@mimeMessage.From.ToString()</p>

            <p class="ticket-to">@mimeMessage.To.ToString()</p>

            @if (body.BlockedRemoteContent)
            {
                <p class="ticket-blocked">
                    <span>
                        Images and other content this email loads from elsewhere are blocked.
                        Fetching them tells the sender their message was opened.
                    </span>
                    <a class="ticket-blocked-trust" href="?trust=true">Load remote content</a>
                </p>
            }

            <div class="ticket-body">
                @if (mimeMessage.HtmlBody is not null)
                {
                    @body.Html
                }
                else
                {
                    <div class="ticket-body-text">@mimeMessage.TextBody</div>
                }
            </div>
        }
    </div>
</article>

@code {
    [Parameter]
    public string TicketId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "trust")]
    public bool TrustRemoteContent { get; set; }

    private MimeMessage? mimeMessage;

    protected override async Task OnInitializedAsync()
    {
        mimeMessage = await emailReaderService.ReadEmailAsync(TicketId);
    }
}
