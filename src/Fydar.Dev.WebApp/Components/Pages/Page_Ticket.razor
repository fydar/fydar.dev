@using Fydar.Dev.Services.EmailTickets;
@using Fydar.Dev.WebApp.Internal;
@using MimeKit

@layout DefaultLayout
@page "/ticket/{ticketId}"

<!-- Disabled whilst framework.js is also disabled @@attribute [StreamRendering(true)] -->

@inject IEmailReaderService emailReaderService;
@inject TicketHtmlSanitizer ticketHtmlSanitizer;

<PageTitle>Ticket - Fydar</PageTitle>

<article class="page-ticket">
    <div class="container" style="max-width: 900px;">
        
        @if (mimeMessage == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <p class="ticket-from">@mimeMessage.From.ToString()</p>

            <p class="ticket-to">@mimeMessage.To.ToString()</p>

            <div class="ticket-body">
                @if (mimeMessage.HtmlBody is string htmlBody)
                {
                    @ticketHtmlSanitizer.Sanitize(htmlBody)
                }
                else
                {
                    <div class="ticket-body-text">@mimeMessage.TextBody</div>
                }
            </div>
        }
    </div>
</article>

@code {
    [Parameter]
    public string TicketId { get; set; } = string.Empty;

    private MimeMessage? mimeMessage;

    protected override async Task OnInitializedAsync()
    {
        mimeMessage = await emailReaderService.ReadEmailAsync(TicketId);
    }
}
