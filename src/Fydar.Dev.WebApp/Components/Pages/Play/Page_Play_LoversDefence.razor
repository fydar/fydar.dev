@layout GameLayout
@page "/play/loversdefence"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Lovers' Defence - Fydar");
		factory.UseDescription("A narrative driven tower defence game.");
		factory.UseCanonicalUrl("https://fydar.dev/play/loversdefence");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/loversdefence/social.webp";
			image.Alt = "Promotional material for the game 'Lovers Defence'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Lovers' Defence", "https://fydar.dev/play/loversdefence"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/loversdefence/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/loversdefence/build/loversdefence.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Lovers Defence",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/loversdefence/build/loversdefence.loader.js"],
        FrameworkUrl = Assets["/play/loversdefence/build/loversdefence.framework.js.br"],
        CodeUrl = Assets["/play/loversdefence/build/loversdefence.wasm.br"],
        DataUrl = Assets["/play/loversdefence/build/loversdefence.data.br"],
        StreamingAssetsUrl = "/play/loversdefence/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["media/loversdefence/titlecard.png"]" alt="Title card for the game 'Lovers Defence'." style="width: 200px; max-width: 90%; margin-bottom: 32px; image-rendering: pixelated;" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="loversdefence"
            Scope="/play/loversdefence"
            ServiceWorkerUrl="@Assets["play/loversdefence/ServiceWorker.js"]"
            ManifestUrl="@Assets["/play/loversdefence/manifest.webmanifest"]" />
