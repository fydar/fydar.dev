@layout GameLayout
@page "/play/astralelites"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Astral Elites - Fydar");
		factory.UseDescription("The physics-based and fast-paced asteroids clone for the modern era.");
		factory.UseCanonicalUrl("https://fydar.dev/play/astralelites");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/astralelites/social.webp";
			image.Alt = "Promotional material for the game 'Astral Elites'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Astral Elites", "https://fydar.dev/play/astralelites"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/astralelites/favicon.svg"]">
	<link rel="preload" href="@Assets["/play/astralelites/build/0.1.2.10.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

<EmbedUnity__AstralElites IsBackground="@Background" />

<PwaInstall AppId="astralelites"
            Scope="/play/astralelites"
            ServiceWorkerUrl="@Assets["play/astralelites.serviceworker.js"]"
            ManifestUrl="@Assets["/play/astralelites/manifest.webmanifest"]" />

@code {
    [Parameter][SupplyParameterFromQuery(Name = "background")] public bool Background { get; set; } = false;
}
