@layout GameLayout
@page "/play/roadtonorthstead"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Road to Northstead - Fydar");
		factory.UseDescription("The game jam visual novel with questing and crafting to survive the night.");
		factory.UseCanonicalUrl("https://fydar.dev/play/roadtonorthstead");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/roadtonorthstead/social.webp";
			image.Alt = "Promotional material for the game 'Road to Northstead'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Road to Northstead", "https://fydar.dev/play/roadtonorthstead"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/roadtonorthstead/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/roadtonorthstead/build/roadtonorthstead.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Road to Northstead",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/roadtonorthstead/build/roadtonorthstead.loader.js"],
        FrameworkUrl = Assets["/play/roadtonorthstead/build/roadtonorthstead.framework.js.br"],
        CodeUrl = Assets["/play/roadtonorthstead/build/roadtonorthstead.wasm.br"],
        DataUrl = Assets["/play/roadtonorthstead/build/roadtonorthstead.data.br"],
        StreamingAssetsUrl = "/play/roadtonorthstead/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/roadtonorthstead/favicon.ico"]" alt="The logo for 'Road to Northstead'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="roadtonorthstead"
            Scope="/play/roadtonorthstead"
            ServiceWorkerUrl="@Assets["play/roadtonorthstead.serviceworker.js"]"
            ManifestUrl="@Assets["/play/roadtonorthstead/manifest.webmanifest"]" />
