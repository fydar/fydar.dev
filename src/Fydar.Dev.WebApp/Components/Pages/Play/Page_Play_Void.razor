@layout GameLayout
@page "/play/void"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Void - Fydar");
		factory.UseDescription("Explore the empty void, deploy mining vessels to mine asteroids.");
		factory.UseCanonicalUrl("https://fydar.dev/play/void");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/void/social.webp";
			image.Alt = "Promotional material for the game 'Void'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Void", "https://fydar.dev/play/void"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/void/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/void/build/void.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Void",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/void/build/void.loader.js"],
        FrameworkUrl = Assets["/play/void/build/void.framework.js.br"],
        CodeUrl = Assets["/play/void/build/void.wasm.br"],
        DataUrl = Assets["/play/void/build/void.data.br"],
        StreamingAssetsUrl = "/play/void/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/void/favicon.ico"]" alt="The logo for 'Void'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="void"
            Scope="/play/void"
            ServiceWorkerUrl="@Assets["play/void.serviceworker.js"]"
            ManifestUrl="@Assets["/play/void/manifest.webmanifest"]" />
