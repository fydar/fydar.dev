@layout GameLayout
@page "/play/lostblues"

@{
    void PageMetadata(IMetadataFactory factory)
    {
        factory.UseTitle("Play Lost Blues - Fydar");
        factory.UseDescription("The clicker-style where you farm kelp and release fish.");
        factory.UseCanonicalUrl("https://fydar.dev/play/lostblues");
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/lostblues/social.webp";
            image.Alt = "Promotional material for the game 'Lost Blues'.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
        new BreadcrumbListItem("Lost Blues", "https://fydar.dev/play/lostblues"),
    };
}

<HeadFragment>
    <MetadataComponent Metadata="@PageMetadata" />
    <BreadcrumbListComponent Model="@breadcrumbs" />
    <meta name="theme-color" content="#161618">
    <link rel="shortcut icon" href="@Assets["/play/lostblues/favicon.ico"]">
    <link rel="preload" href="@Assets["/play/lostblues/build/lostblues.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Lost Blues",
        ProductVersion = new Version(0, 1, 1),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/lostblues/build/lostblues.loader.js"],
        FrameworkUrl = Assets["/play/lostblues/build/lostblues.framework.js.br"],
        CodeUrl = Assets["/play/lostblues/build/lostblues.wasm.br"],
        DataUrl = Assets["/play/lostblues/build/lostblues.data.br"],
        StreamingAssetsUrl = "/play/lostblues/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/lostblues/favicon.ico"]" alt="The logo for 'Lost Blues'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="lostblues"
            Scope="/play/lostblues"
            ServiceWorkerUrl="@Assets["play/lostblues.serviceworker.js"]"
            ManifestUrl="@Assets["/play/lostblues/manifest.webmanifest"]" />
