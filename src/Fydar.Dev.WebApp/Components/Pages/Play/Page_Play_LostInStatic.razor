@layout GameLayout
@page "/play/lostinstatic"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Lost in Static - Fydar");
		factory.UseDescription("Remote control a drone to take down a rogue AI controlling the station.");
		factory.UseCanonicalUrl("https://fydar.dev/play/lostinstatic");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/lostinstatic/social.webp";
			image.Alt = "Promotional material for the game 'Lost in Static'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Lost in Static", "https://fydar.dev/play/lostinstatic"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/lostinstatic/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/lostinstatic/build/lostinstatic.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Lost in Static",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar, Lewis, Kris, Laurence, and Samirah",
        LoaderUrl = Assets["/play/lostinstatic/build/lostinstatic.loader.js"],
        FrameworkUrl = Assets["/play/lostinstatic/build/lostinstatic.framework.js.br"],
        CodeUrl = Assets["/play/lostinstatic/build/lostinstatic.wasm.br"],
        DataUrl = Assets["/play/lostinstatic/build/lostinstatic.data.br"],
        StreamingAssetsUrl = "/play/lostinstatic/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/lostinstatic/favicon.ico"]" alt="The logo for 'Lost in Static'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="lostinstatic"
            Scope="/play/lostinstatic"
            ServiceWorkerUrl="@Assets["play/lostinstatic.serviceworker.js"]"
            ManifestUrl="@Assets["/play/lostinstatic/manifest.webmanifest"]" />
