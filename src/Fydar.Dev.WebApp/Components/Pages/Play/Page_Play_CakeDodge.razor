@layout GameLayout
@page "/play/cakedodge"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Cake Dodge - Fydar");
		factory.UseDescription("Play as Cookie, a little monster who is unfortunately allergic to cake.");
		factory.UseCanonicalUrl("https://fydar.dev/play/cakedodge");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/cakedodge/social.webp";
			image.Alt = "Promotional material for the game 'Cake Dodge'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Cake Dodge", "https://fydar.dev/play/cakedodge"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/cakedodge/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/cakedodge/build/cakedodge.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Cake Dodge",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/cakedodge/build/cakedodge.loader.js"],
        FrameworkUrl = Assets["/play/cakedodge/build/cakedodge.framework.js.br"],
        CodeUrl = Assets["/play/cakedodge/build/cakedodge.wasm.br"],
        DataUrl = Assets["/play/cakedodge/build/cakedodge.data.br"],
        StreamingAssetsUrl = "/play/cakedodge/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/cakedodge/loading.svg"]" alt="The logo for 'Cake Dodge'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="cakedodge"
            Scope="/play/cakedodge"
            ServiceWorkerUrl="@Assets["play/cakedodge.serviceworker.js"]"
            ManifestUrl="@Assets["/play/cakedodge/manifest.webmanifest"]" />
