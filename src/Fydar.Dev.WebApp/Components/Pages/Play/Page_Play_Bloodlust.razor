@layout GameLayout
@page "/play/bloodlust"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Bloodlust - Fydar");
		factory.UseDescription("The morality of a recently turned vampire comes into question when his thirst for life must be quenched.");
		factory.UseCanonicalUrl("https://fydar.dev/play/bloodlust");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/bloodlust/social.webp";
			image.Alt = "Promotional material for the game 'Bloodlust'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Bloodlust", "https://fydar.dev/play/bloodlust"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/bloodlust/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/bloodlust/build/bloodlust.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Bloodlust",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/bloodlust/build/bloodlust.loader.js"],
        FrameworkUrl = Assets["/play/bloodlust/build/bloodlust.framework.js.br"],
        CodeUrl = Assets["/play/bloodlust/build/bloodlust.wasm.br"],
        DataUrl = Assets["/play/bloodlust/build/bloodlust.data.br"],
        StreamingAssetsUrl = "/play/bloodlust/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/bloodlust/favicon.ico"]" alt="The logo for 'Bloodlust'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="bloodlust"
            Scope="/play/bloodlust"
            ServiceWorkerUrl="@Assets["play/bloodlust.serviceworker.js"]"
            ManifestUrl="@Assets["/play/bloodlust/manifest.webmanifest"]" />
