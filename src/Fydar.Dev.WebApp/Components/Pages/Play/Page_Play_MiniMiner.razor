@layout GameLayout
@page "/play/miniminer"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Mini Miner - Fydar");
		factory.UseDescription("The Game Boy demake of the Nintendo DS Pokémon Diamond and Pearl underground mining minigame.");
		factory.UseCanonicalUrl("https://fydar.dev/play/miniminer");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/miniminer/social.webp";
			image.Alt = "Promotional material for the game 'Mini Miner'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Mini Miner", "https://fydar.dev/play/miniminer"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/miniminer/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/miniminer/build/miniminer.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Mini Miner",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/miniminer/build/miniminer.loader.js"],
        FrameworkUrl = Assets["/play/miniminer/build/miniminer.framework.js.br"],
        CodeUrl = Assets["/play/miniminer/build/miniminer.wasm.br"],
        DataUrl = Assets["/play/miniminer/build/miniminer.data.br"],
        StreamingAssetsUrl = "/play/miniminer/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/miniminer/favicon.ico"]" alt="The logo for 'Mini Miner'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="miniminer"
            Scope="/play/miniminer"
            ServiceWorkerUrl="@Assets["play/miniminer/ServiceWorker.js"]"
            ManifestUrl="@Assets["/play/miniminer/manifest.webmanifest"]" />
