@layout GameLayout
@page "/play/snoot"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Snoot - Fydar");
		factory.UseDescription("Restore life to a desolate world by exploring a sandbox of crafting recipes. On your adventure you will bring rain, grass, bugs, birds, and bees.");
		factory.UseCanonicalUrl("https://fydar.dev/play/snoot");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/snoot/social.webp";
			image.Alt = "Promotional material for the game 'Snoot'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Snoot", "https://fydar.dev/play/snoot"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/snoot/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/snoot/build/snoot.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Snoot",
        ProductVersion = new Version(0, 0, 4),
        CompanyName = "Fydar, Emma, and Tim",
        LoaderUrl = Assets["/play/snoot/build/snoot.loader.js"],
        FrameworkUrl = Assets["/play/snoot/build/snoot.framework.js.br"],
        CodeUrl = Assets["/play/snoot/build/snoot.wasm.br"],
        DataUrl = Assets["/play/snoot/build/snoot.data.br"],
        StreamingAssetsUrl = "/play/snoot/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/snoot/favicon.ico"]" alt="The logo for 'Snoot'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="snoot"
            Scope="/play/snoot"
            ServiceWorkerUrl="@Assets["play/snoot.serviceworker.js"]"
            ManifestUrl="@Assets["/play/snoot/manifest.webmanifest"]" />
