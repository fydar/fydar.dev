@layout DefaultLayout
@page "/play"

@{
    void PageMetadata(IMetadataFactory factory)
    {
        factory.UseTitle("Play - Fydar");
        factory.UseDescription("Explore my library of playable games and experiences.");
        factory.UseCanonicalUrl("https://fydar.dev/play");
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/placeholdersocial.webp";
            image.Alt = "Fydar's signature.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
    };
}

<HeadFragment>
    <MetadataComponent Metadata="@PageMetadata" />
    <BreadcrumbListComponent Model="@breadcrumbs" />
</HeadFragment>

<section class="container" style="max-width: 680px;place-self: center;">

    <h2>Play</h2>

    <AppIconGrid>
        <AppIcon target="_blank" href="/play/astralswarm" Link="/icons.svg?v=1#icon-astralswarm" Hue="0deg" />
        <AppIcon target="_blank" href="/play/astralelites" Link="/icons.svg?v=1#icon-astralelites" Hue="30deg" />
        <AppIcon target="_blank" href="/play/miniminer" Link="/icons.svg?v=1#icon-miniminer" Hue="120deg" />
        <AppIcon target="_blank" href="/play/lilypadleap" Link="/icons.svg?v=1#icon-lilypadleap" Hue="110deg" />
        <AppIcon target="_blank" href="/play/raidhealersimulator" Link="/icons.svg?v=1#icon-raidhealersimulator" Hue="100deg" />
        <AppIcon target="_blank" href="/play/snoot" Link="/icons.svg?v=1#icon-snoot" Hue="50deg" />
        <AppIcon target="_blank" href="/play/cakedodge" Link="/icons.svg?v=1#icon-cakedodge" Hue="230deg" />
        <AppIcon target="_blank" href="/play/thedwellers" Link="/icons.svg?v=1#icon-thedwellers" Hue="180deg" />
        <AppIcon target="_blank" href="/play/thenewearthconflict" Link="/icons.svg?v=1#icon-thenewearthconflict" Hue="150deg" />
        <AppIcon target="_blank" href="/play/lostblues" Link="/icons.svg?v=1#icon-lostblues" Hue="200deg" />
        <AppIcon target="_blank" href="/play/roadtonorthstead" Link="/icons.svg?v=1#icon-roadtonorthstead" Hue="50deg" />
        <AppIcon target="_blank" href="/play/sofarfromhome" Link="/icons.svg?v=1#icon-sofarfromhome" Hue="10deg" />
        <AppIcon target="_blank" href="/play/void" Link="/icons.svg?v=1#icon-void" Hue="320deg" />
        <AppIcon target="_blank" href="/play/airseabattle" Link="/icons.svg?v=1#icon-airseabattle" Hue="180deg" />
        <AppIcon target="_blank" href="/play/lostinstatic" Link="/icons.svg?v=1#icon-lostinstatic" Hue="30deg" />
        <AppIcon target="_blank" href="/play/bloodlust" Link="/icons.svg?v=1#icon-bloodlust" Hue="0deg" />
        <AppIcon target="_blank" href="/play/loversdefence" Link="/icons.svg?v=1#icon-loversdefence" Hue="220deg" />
        <AppIcon target="_blank" href="/play/cryptcrawl" Link="/icons.svg?v=1#icon-cryptcrawl" Hue="30deg" />
    </AppIconGrid>

</section>
