@layout GameLayout
@page "/play/endlessplatform"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Endless Platform - Fydar");
		factory.UseDescription("A fully procedurally generated spline-based terrain for a 2D platformer.");
		factory.UseCanonicalUrl("https://fydar.dev/play/endlessplatform");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/endlessplatform/social.webp";
			image.Alt = "Promotional material for the game 'Endless Platform'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Endless Platform", "https://fydar.dev/play/endlessplatform"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/endlessplatform/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/endlessplatform/build/endlessplatform.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Endless Platform",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/endlessplatform/build/endlessplatform.loader.js"],
        FrameworkUrl = Assets["/play/endlessplatform/build/endlessplatform.framework.js.br"],
        CodeUrl = Assets["/play/endlessplatform/build/endlessplatform.wasm.br"],
        DataUrl = Assets["/play/endlessplatform/build/endlessplatform.data.br"],
        StreamingAssetsUrl = "/play/endlessplatform/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/endlessplatform/favicon.ico"]" alt="The logo for 'Endless Platform'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="endlessplatform"
            Scope="/play/endlessplatform"
            ServiceWorkerUrl="@Assets["play/endlessplatform.serviceworker.js"]"
            ManifestUrl="@Assets["/play/endlessplatform/manifest.webmanifest"]" />
