@layout GameLayout
@page "/play/astralswarm"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Astral Swarm - Fydar");
		factory.UseDescription("Battle endless swarms of enemy space ships across the galaxy.");
		factory.UseCanonicalUrl("https://fydar.dev/play/astralswarm");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/astralswarm/social.webp";
			image.Alt = "Promotional material for the game 'Astral Swarm'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Astral Swarm", "https://fydar.dev/play/astralswarm"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/astralswarm/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/astralswarm/build/astralswarm.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Astral Swarm",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Out of the Blue Studios",
        LoaderUrl = Assets["/play/astralswarm/build/astralswarm.loader.js"],
        FrameworkUrl = Assets["/play/astralswarm/build/astralswarm.framework.js.br"],
        CodeUrl = Assets["/play/astralswarm/build/astralswarm.wasm.br"],
        DataUrl = Assets["/play/astralswarm/build/astralswarm.data.br"],
        StreamingAssetsUrl = "/play/astralswarm/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/astralswarm/favicon.ico"]" alt="The logo for 'Astral Swarm'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="astralswarm"
            Scope="/play/astralswarm"
            ServiceWorkerUrl="@Assets["play/astralswarm.serviceworker.js"]"
            ManifestUrl="@Assets["/play/astralswarm/manifest.webmanifest"]" />
