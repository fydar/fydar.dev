@layout GameLayout
@page "/play/thenewearthconflict"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play The New Earth Conflict - Fydar");
		factory.UseDescription("A realtime space strategy game where the player takes the pilot seat of a battleship.");
		factory.UseCanonicalUrl("https://fydar.dev/play/thenewearthconflict");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/thenewearthconflict/social.webp";
			image.Alt = "Promotional material for the game 'The New Earth Conflict'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("The New Earth Conflict", "https://fydar.dev/play/thenewearthconflict"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/thenewearthconflict/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/thenewearthconflict/build/thenewearthconflict.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "The New Earth Conflict",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/thenewearthconflict/build/thenewearthconflict.loader.js"],
        FrameworkUrl = Assets["/play/thenewearthconflict/build/thenewearthconflict.framework.js.br"],
        CodeUrl = Assets["/play/thenewearthconflict/build/thenewearthconflict.wasm.br"],
        DataUrl = Assets["/play/thenewearthconflict/build/thenewearthconflict.data.br"],
        StreamingAssetsUrl = "/play/thenewearthconflict/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/thenewearthconflict/favicon.ico"]" alt="The logo for 'The New Earth Conflict'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="thenewearthconflict"
            Scope="/play/thenewearthconflict"
            ServiceWorkerUrl="@Assets["play/thenewearthconflict.serviceworker.js"]"
            ManifestUrl="@Assets["/play/thenewearthconflict/manifest.webmanifest"]" />
