@layout GameLayout
@page "/play/sofarfromhome"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play So Far From Home - Fydar");
		factory.UseDescription("Searching between the sofa cushions for a missing key, but what else is down there?");
		factory.UseCanonicalUrl("https://fydar.dev/play/sofarfromhome");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/sofarfromhome/social.webp";
			image.Alt = "Promotional material for the game 'So Far From Home'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("So Far From Home", "https://fydar.dev/play/sofarfromhome"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/sofarfromhome/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/sofarfromhome/build/sofarfromhome.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Lost in Static",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar, Paul, Amy, Evan, Denis, and Gabrielle",
        LoaderUrl = Assets["/play/sofarfromhome/build/sofarfromhome.loader.js"],
        FrameworkUrl = Assets["/play/sofarfromhome/build/sofarfromhome.framework.js.br"],
        CodeUrl = Assets["/play/sofarfromhome/build/sofarfromhome.wasm.br"],
        DataUrl = Assets["/play/sofarfromhome/build/sofarfromhome.data.br"],
        StreamingAssetsUrl = "/play/sofarfromhome/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/sofarfromhome/favicon.ico"]" alt="The logo for 'So Far From Home'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="sofarfromhome"
            Scope="/play/sofarfromhome"
            ServiceWorkerUrl="@Assets["play/sofarfromhome.serviceworker.js"]"
            ManifestUrl="@Assets["/play/sofarfromhome/manifest.webmanifest"]" />
