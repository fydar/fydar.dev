@layout GameLayout
@page "/play/raidhealersimulator"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Raid Healer Simulator - Fydar");
		factory.UseDescription("The simulation experience of what it’s like to be a healer in an MMORPG raid, complete with a variety of abilities and a challenging boss battle.");
		factory.UseCanonicalUrl("https://fydar.dev/play/raidhealersimulator");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/raidhealersimulator/social.webp";
			image.Alt = "Promotional material for the game ‘Raid Healer Simulator’.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Raid Healer Simulator", "https://fydar.dev/play/raidhealersimulator"),
	};
}

<HeadFragment>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/raidhealersimulator/favicon.ico"]">
    <link rel="preload" href="@Assets["/play/raidhealersimulator/build/0.1.2.1.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Raid Healer Simulator",
        ProductVersion = new Version(0, 1, 2, 1),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/raidhealersimulator/build/0.1.2.1.loader.js"],
        FrameworkUrl = Assets["/play/raidhealersimulator/build/0.1.2.1.framework.js.br"],
        CodeUrl = Assets["/play/raidhealersimulator/build/0.1.2.1.wasm.br"],
        DataUrl = Assets["/play/raidhealersimulator/build/0.1.2.1.data.br"],
        StreamingAssetsUrl = "/play/raidhealersimulator/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/raidhealersimulator/favicon.ico"]" alt="The logo for 'Raid Healer Simulator'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="raidhealersimulator"
            Scope="/play/raidhealersimulator"
            ServiceWorkerUrl="@Assets["play/raidhealersimulator.serviceworker.js"]"
            ManifestUrl="@Assets["/play/raidhealersimulator/manifest.webmanifest"]" />
