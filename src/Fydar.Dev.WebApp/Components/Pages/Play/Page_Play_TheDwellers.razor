@layout GameLayout
@page "/play/thedwellers"

@{
    void PageMetadata(IMetadataFactory factory)
    {
        factory.UseTitle("Play The Dwellers - Fydar");
        factory.UseDescription("A 3D dungeon crawler game demo with a full RPG item system, featuring a wide range of weapons and other equipment.");
        factory.UseCanonicalUrl("https://fydar.dev/play/thedwellers");
        factory.UseImage(image =>
        {
            image.Url = "https://fydar.dev/media/thedwellers/social.webp";
            image.Alt = "Promotional material for the game 'The Dwellers'.";
        });
    }
    var breadcrumbs = new BreadcrumbList()
    {
        new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
        new BreadcrumbListItem("The Dwellers", "https://fydar.dev/play/thedwellers"),
    };
}

<HeadFragment>
    <MetadataComponent Metadata="@PageMetadata" />
    <BreadcrumbListComponent Model="@breadcrumbs" />
    <meta name="theme-color" content="#161618">
    <link rel="shortcut icon" href="@Assets["/play/thedwellers/favicon.ico"]">
    <link rel="preload" href="@Assets["/play/thedwellers/build/thedwellers.loader.js"]" as="script" fetchpriority="high" />
</HeadFragment>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "The Dwellers",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/thedwellers/build/thedwellers.loader.js"],
        FrameworkUrl = Assets["/play/thedwellers/build/thedwellers.framework.js.br"],
        CodeUrl = Assets["/play/thedwellers/build/thedwellers.wasm.br"],
        DataUrl = Assets["/play/thedwellers/build/thedwellers.data.br"],
        StreamingAssetsUrl = "/play/thedwellers/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/thedwellers/favicon.ico"]" alt="The logo for 'The Dwellers'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="thedwellers"
            Scope="/play/thedwellers"
            ServiceWorkerUrl="@Assets["play/thedwellers.serviceworker.js"]"
            ManifestUrl="@Assets["/play/thedwellers/manifest.webmanifest"]" />
