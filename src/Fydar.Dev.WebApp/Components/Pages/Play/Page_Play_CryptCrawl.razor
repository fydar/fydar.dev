@layout GameLayout
@page "/play/cryptcrawl"

@{
	void PageMetadata(IMetadataFactory factory)
	{
		factory.UseTitle("Play Crypt Crawl - Fydar");
		factory.UseDescription("A pixel art dungeon crawler with dungeon textures generated in Substance Designer.");
		factory.UseCanonicalUrl("https://fydar.dev/play/cryptcrawl");
		factory.UseImage(image =>
		{
			image.Url = "https://fydar.dev/media/cryptcrawl/social.webp";
			image.Alt = "Promotional material for the game 'Crypt Crawl'.";
		});
	}
	var breadcrumbs = new BreadcrumbList()
	{
		new BreadcrumbListItem("Play", "https://fydar.dev/play/"),
		new BreadcrumbListItem("Crypt Crawl", "https://fydar.dev/play/cryptcrawl"),
	};
}

<HeadContent>
	<MetadataComponent Metadata="@PageMetadata" />
	<BreadcrumbListComponent Model="@breadcrumbs" />
	<meta name="theme-color" content="#161618">
	<link rel="shortcut icon" href="@Assets["/play/cryptcrawl/favicon.ico"]">
	<link rel="preload" href="@Assets["/play/cryptcrawl/build/cryptcrawl.loader.js"]" as="script" fetchpriority="high" />
</HeadContent>

@{
    var embedUnityConfig = new EmbedUnityConfig()
    {
        ProductName = "Crypt Crawl",
        ProductVersion = new Version(0, 1, 0),
        CompanyName = "Fydar",
        LoaderUrl = Assets["/play/cryptcrawl/build/cryptcrawl.loader.js"],
        FrameworkUrl = Assets["/play/cryptcrawl/build/cryptcrawl.framework.js.br"],
        CodeUrl = Assets["/play/cryptcrawl/build/cryptcrawl.wasm.br"],
        DataUrl = Assets["/play/cryptcrawl/build/cryptcrawl.data.br"],
        StreamingAssetsUrl = "/play/cryptcrawl/StreamingAssets",
        Arguments = [],
    };
}

<EmbedUnity Config="embedUnityConfig">
    <Placeholder>
        <img decoding="async" src="@Assets["play/cryptcrawl/favicon.ico"]" alt="The logo for 'Crypt Crawl'." class="embed--placeholdermainappicon" />
    </Placeholder>
</EmbedUnity>

<PwaInstall AppId="cryptcrawl"
            Scope="/play/cryptcrawl"
            ServiceWorkerUrl="@Assets["play/cryptcrawl/ServiceWorker.js"]"
            ManifestUrl="@Assets["/play/cryptcrawl/manifest.webmanifest"]" />
